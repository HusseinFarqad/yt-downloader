# Server Configuration
PORT=5000

# YouTube Authentication (Optional but recommended)
# YouTube may block requests without proper authentication.
# You can configure cookies or OAuth2 tokens to bypass this restriction.

# Option 1: Using Cookies (Recommended)
# Export your YouTube cookies as JSON array
# Example: YOUTUBE_COOKIES='[{"name":"cookie1","value":"value1"},{"name":"cookie2","value":"value2"}]'
# YOUTUBE_COOKIES=

# Option 2: Using OAuth2 Tokens
# Configure OAuth2 tokens for YouTube API access
# Example: YOUTUBE_OAUTH2_TOKENS='{"access_token":"your_token","refresh_token":"your_refresh_token"}'
# YOUTUBE_OAUTH2_TOKENS=

# How to get cookies:
# 1. Install a browser extension like "Cookie Editor" or "EditThisCookie"
# 2. Go to youtube.com and log in
# 3. Export cookies as JSON
# 4. Set the YOUTUBE_COOKIES environment variable with the JSON string
